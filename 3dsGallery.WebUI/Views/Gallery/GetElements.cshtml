@model IEnumerable<_3dsGallery.DataLayer.DataBase.Gallery>

@foreach (var itemGal in Model)
{
    bool is3d = itemGal.Picture.Any(x => x.type == "3D" && (x.RemoteAsset == null || x.RemoteAsset.StorageMigrationStatus != _3dsGallery.WebUI.Code.PictureStorageConstants.MigrationStatusDeletePending)) ? true : false;
    <div class="col-md-4">
        <div class="panel panel-@itemGal.Style.value">
            <div class="panel-heading">
                <div class="gallery-badges">
                    @if (is3d)
                {
                        <span class="badge">3D</span>
                    }
                    <span class="badge">@itemGal.Picture.Count(x => x.RemoteAsset == null || x.RemoteAsset.StorageMigrationStatus != _3dsGallery.WebUI.Code.PictureStorageConstants.MigrationStatusDeletePending)</span>
                </div>
                <div class="one-line">
                    @if (itemGal.User.login == User.Identity.Name)
                {
                        <a href="@Url.Action("AddPicture", "Gallery", new { id = itemGal.id })" class="btn btn-@itemGal.Style.value btn-add">+</a>
                    }
                    <a href="@Url.Action("Details", "Gallery", new { id = itemGal.id })" class="gallery-name">@itemGal.name</a>
                </div>
            </div>
            <div class="panel-body preview-gallery">
                @{
                    int counter = 2;
                    var previews = itemGal.Picture.Where(x => x.RemoteAsset == null || x.RemoteAsset.StorageMigrationStatus != _3dsGallery.WebUI.Code.PictureStorageConstants.MigrationStatusDeletePending).OrderByDescending(x => x.id).Take(counter);
                    foreach (var pv in previews)
                    {
                        <div class="preview-container-sm">
                            <a target="_blank" href="@Url.Action("OpenOriginal", "Picture", new { id = pv.id })">
                                <img class="img-thumbnail preview-img " src="@Url.Action("Preview", "Picture", new { id = pv.id, size = "sm" })">
                            </a>
                        </div>
                                        counter--;
                                    }
                                    for (int i = 0; i < counter; i++)
                                    {
                                        <div class="preview-container-sm">
                                            <img class="img-thumbnail preview-img">
                                        </div>
                                    }
                }
            </div>
            <div class="panel-heading gallery-info">
                <a href="~/User/@itemGal.User.login"><i>@itemGal.User.login</i></a>
            </div>
        </div>
    </div>
                                    }