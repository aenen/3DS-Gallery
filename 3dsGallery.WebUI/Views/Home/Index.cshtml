@model _3dsGallery.WebUI.Models.HomePageModel
@{
    ViewBag.Title = "Home";
    var is3ds = Request.UserAgent.Contains("Nintendo 3DS").ToString().ToLower();
    int gallery_count = Request.UserAgent.Contains("Nintendo 3DS") ? 2 : 3;
    int picture_count = Request.UserAgent.Contains("Nintendo 3DS") ? 3 : 12;
    string authName = @User.Identity.Name;
}

<div id="banner-section"
     class="section-@(Model.RandomStyleValueEx ?? Model.RandomStyleValue) text-@Model.RandomStyleValue">
    <div class="container body-content text-center">
        <h1 class="logo">
            <a class="no-link-style" href="/"><span class="text-3ds-red">3</span><span class="text-3ds-dark">DS</span> GALLERY</a>
        </h1>
        <p><b><em>ニンテンドー<span class="text-3ds-red">3</span><span class="text-3ds-dark">DS</span>ギャラリー</em></b></p>
        <p id="banner-tagline">@Html.Raw(Model.RandomTagline)</p>
        <button id="get-timecapsule" class="btn inline btn-@Model.RandomStyleValue">Dig out a Time Capsule</button>
        <a id="info-timecapsule" class="btn btn-xs btn-@Model.RandomStyleValue">?</a>
    </div>
</div>

<div id="timecapsule-section" hidden
     class="section-@(Model.RandomStyleValueEx ?? Model.RandomStyleValue) text-@Model.RandomStyleValue">
    <div class="container body-content text-center">
        <p><b>[Under Development. Releasing May, 24 (1y public anniversary)]</b><br />[I hope you'll like this Time Capsules thingy]<br />[After this i'll finally add MOTHER FRICKING COMMENTS so you can cyberbully someone here.]</p>
        <p id="msg-timecapsule"></p>
        <div id="img-timecapsule" class="row"></div>
        <p id="refresh-timecapsule"></p>
    </div>
</div>

<div class="section-white">
    <div class="container body-content">
        <div class="h2-container">
            <a href="@Url.Action("Index", "Gallery")" class="btn btn-success pull-right">View all</a>
            <h2 class="text-success">Latest Updates</h2>
        </div>
        <div class="row">
            @{ Html.RenderAction("GetGalleryElements", "Gallery", new { items = Model.GalleryList }); }

            <p class="visible-xs-block hidden-sm hidden-md hidden-lg text-center mb-20">
                <a href="@Url.Action("Index", "Gallery")" class="btn btn-success">...and @(Model.TotalGalleryCount - gallery_count) more!</a>
            </p>
        </div>
    </div>
</div>

<div class="section-grey">
    <div class="container body-content">
        <div class="h2-container">
            <a href="@Url.Action("Index", "Picture")" class="btn btn-info pull-right">View all</a>
            <h2 class="text-info">Latest Images</h2>
        </div>
        <div class="row">
            @{ Html.RenderAction("GetPictureElements", "Picture", new { items = Model.PictureList }); }

            <p class="visible-xs-block hidden-sm hidden-md hidden-lg text-center mb-20">
                <a href="@Url.Action("Index", "Picture")" class="btn btn-info">...and @(Model.TotalImageCount - picture_count) more!</a>
            </p>
        </div>
    </div>
</div>

<div class="section-white dashed-bottom">
    <div class="container body-content">
        <div class="h2-container">
            <h2 class="text-danger">See 3D Without a <span class="kawaii"><span class="text-3ds-red">3</span><span class="text-3ds-dark">DS</span></h2>
        </div>
        <div class="row">
            <div class="col-xs-12">
                <p>
                    You <b class="text-danger">can</b> view in 3D using the <em class="text-danger">parallel viewing method</em>, which works on <strong class="text-danger">any screen*</strong>.<br />
                    Relax your eyes until the two side-by-side images merge into one - then you’ll see <strong class="text-danger">depth in 3D</strong> (<a target="_blank" href="https://en.wikipedia.org/wiki/Stereoscopy#Freeviewing">learn more</a>).
                </p>

                <p>
                    <b class="text-danger">Click the</b> <span class="type-paralel-view-guide"><strong>3D</strong></span> icon in the top-right corner of an image to open it in <em class="text-danger">side-by-side mode</em>.<br />
                    Or press the button below to view a <strong class="text-danger">random 3D image</strong> from <b class="text-danger"><em>@(Model.Total3DImageCount)</em></b>.
                </p>
                <p class="text-footnote"><em><b class="text-danger">*</b>works best on a <span class="text-tiny">small</span> screen</em></p>
                <button id="rndSbsPic" class="btn btn-danger mb-20">Show me</button>
                <span hidden><div id="rndSbsPicClickCount" class="btn disabled"></div></span>
                <div class="mb-20" hidden>
                    <img id="rndPicDisplay" src="" alt="Random 3D pic" class="img-responsive img-border" />
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    @RenderPage("~/Views/Shared/MainScripts.cshtml")

<script>
        function setCookie(cname, cvalue, exdays) {
            var d = new Date();
            d.setTime(d.getTime() + (exdays * 24 * 60 * 60 * 1000));
            var expires = "expires=" + d.toUTCString();
            document.cookie = cname + "=" + cvalue + ";" + expires + ";path=/";
        }

        function getCookie(cname) {
            var name = cname + "=";
            var ca = document.cookie.split(';');
            for (var i = 0; i < ca.length; i++) {
                var c = ca[i];
                while (c.charAt(0) == ' ') {
                    c = c.substring(1);
                }
                if (c.indexOf(name) == 0) {
                    return c.substring(name.length, c.length);
                }
            }
            return "";
        }

        function toIsoDate(d) {
            var y = d.getFullYear();
            var m = d.getMonth() + 1;
            var day = d.getDate();
            return y + "-" + (m < 10 ? "0" + m : m) + "-" + (day < 10 ? "0" + day : day);
        }

        function parseIsoDate(s) {
            var parts = s.split("-");
            return new Date(parts[0], parts[1] - 1, parts[2]);
        }

        var rndSbsPicClickCount = 0;
        var idLoadedTimecapsule = null;
        var tcDugCount = getCookie('tcDugCount');
        var tcDugLastDate = getCookie('tcDugLastDate');
        var tcDayStreak = getCookie('tcDayStreak');
        var tcLongestStreak = getCookie('tcLongestStreak');
        var tcLongestStreakDate = getCookie('tcLongestStreakDate');

        var cookieClickerCount = getCookie('cookieClickerCount');
        if (cookieClickerCount) {
            rndSbsPicClickCount = cookieClickerCount;
            $('#rndSbsPicClickCount').text(cookieClickerCount).parent().show();
        }

        $("#rndSbsPic").click(function () {
            var url = '@Url.Action("RandomGenerateSideBySide", "Picture")' + "?t=" + new Date().getTime();

            if (@is3ds) {
                var newTab = window.open('', '_blank');
                newTab.location.href = url;
            } else {
                $("#rndPicDisplay").attr("src", url);
                $("#rndPicDisplay").parent().show();
            }

            rndSbsPicClickCount++;

            $('#rndSbsPicClickCount').text(rndSbsPicClickCount).parent().show();
            $(this).text('Another one!');

            setCookie('cookieClickerCount', rndSbsPicClickCount, 344);
        });

        $('#info-timecapsule').click(function (e) {
            alert('Time Capsule - is a public image that was uploaded to 3DS Gallery on this day and month, BUT more than a year ago!\n\n' +
                'Dig them out every day to discover interesting pics from the past.\n'+
                'Or upload something yourself - so someone will discover it in the future!\n\n' +
                'Your Stats*:' +
                '\nDug out: ' + (tcDugCount ? tcDugCount : 0) + ' capsules' +
                '\nCurrent Streak: ' + (tcDayStreak ? tcDayStreak : 0) + ' day' + (tcDayStreak == 1 ? '': 's') +
                '\nRecord Streak: ' + (tcLongestStreak ? tcLongestStreak : 0) + ' day' + (tcLongestStreak == 1 ? '' : 's') +
                '\nRecord Streak On: ' + tcLongestStreakDate +
                '\n\n*saved as your browser cookie');
        });
        $('#get-timecapsule').click(function (e) {
            var self = this;
            $.ajax({
                type: "POST",
                url: "@Url.Action("GetTimeCapsule", "Picture")?existingId=" + (idLoadedTimecapsule ? idLoadedTimecapsule : ''),
                success: function (data) {
                    if (!tcDayStreak || tcDugLastDate) {
                        tcDayStreak = 1;
                        tcDugLastDate = toIsoDate(new Date());
                        tcLongestStreak = tcDayStreak;
                        tcLongestStreakDate = tcDugLastDate;

                        setCookie('tcDayStreak', tcDayStreak, 344);
                        setCookie('tcDugLastDate', tcDugLastDate, 344);
                        setCookie('tcLongestStreak', tcLongestStreak, 344);
                        setCookie('tcLongestStreakDate', tcLongestStreakDate, 344);
                    } else {
                        var todayStr = toIsoDate(new Date());
                        var today = parseIsoDate(todayStr);
                        var other = parseIsoDate(tcDugLastDate);
                        var diffMs = today - other;
                        var diffDays = diffMs / (1000 * 60 * 60 * 24);

                        if (diffDays === 1) {
                            tcDayStreak++;
                            setCookie('tcDayStreak', tcDayStreak, 344);
                            tcDugLastDate = todayStr;
                            setCookie('tcDugLastDate', tcDugLastDate, 344);

                            if (tcDayStreak > tcLongestStreak) {
                                tcLongestStreak = tcDayStreak;
                                tcLongestStreakDate = tcDugLastDate;
                                setCookie('tcLongestStreak', tcLongestStreak, 344);
                                setCookie('tcLongestStreakDate', tcLongestStreakDate, 344);
                            }
                        } else if (diffDays > 1) {
                            tcDayStreak = 1;
                            setCookie('tcDayStreak', tcDayStreak, 344);
                            tcDugLastDate = todayStr;
                            setCookie('tcDugLastDate', tcDugLastDate, 344);
                        }
                    }

                    if (!data.TimecapsuleCount && !data.IdPicture) {
                        $('#msg-timecapsule').html('Try again later, or <a target="_blank" href="@(Url.Content("~/AddPicture"))">upload</a> something yourself for people from the future to dig out!');
                        $(self).prop('disabled', true);
                    }

                    $('#refresh-timecapsule').html('<b>' + (data.TimecapsuleCount ? data.TimecapsuleCount : 'No') +
                        '</b> more Time Capsule' + (data.TimecapsuleCount === 1? '': 's') +' can be found today.' +
                        '<br/>Refresh in <b>' + data.RefreshTimeInfo
                    );

                    $('#timecapsule-section,#timecapsule-separator').show();

                    //data.IdPicture = 560;
                    //data.GalleryCssCode = 'nocturnal-purple';

                    if (!data.IdPicture)
                        return;

                    tcDugCount = (tcDugCount ? tcDugCount : 0) + 1;
                    setCookie('tcDugCount', tcDugCount, 344);

                    idLoadedTimecapsule = data.IdPicture;

                    $('#timecapsule-section')
                        .removeClass()
                        .removeClass();

                    $('#timecapsule-section')
                        .addClass('section-' + (data.GalleryCssCodeEx ? data.GalleryCssCodeEx : data.GalleryCssCode))
                        .addClass('text-' + data.GalleryCssCode);


                    $('#msg-timecapsule').html(
                      'On this day, <b>' + data.YearsOld + ' years ago</b>, ' +
                      '<b><a target="_blank" href="@Url.Content("~/User/")' + data.CreatedBy + '">' + data.CreatedBy + '</a></b> ' +
                      'added a picture to "<b><a target="_blank" href="@Url.Content("~/Gallery/")' + data.IdGallery + '">' + data.GalleryName + '</a></b>".'
                    );

                    if (data.TimecapsuleCount > 0)
                        $('#get-timecapsule').text('Dig out another one!');

                    $.ajax({
                        type: "POST",
                        url: "@Url.Action("GetPictureElementById", "Picture")/" + data.IdPicture,
                        success: function (data) {
                            if (data) {
                                $('#img-timecapsule').html(data);
                                initImg();
                            }
                        }
                    });
                }
            });
        });

</script>
}
